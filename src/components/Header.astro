---
import { site } from '../data/site';
import { languageGroups } from '../data/originalLanguages';
const { pathname } = Astro.url;
const active = (href: string) => pathname.replace(/\/+$/, '') === href.replace(/\/+$/, '');
---
<header class="site-header wrap">
  <div class="utility">
    <a class="small-monogram" href="/" aria-label="TSQ home">TSQ</a>
    <span>Literature · Arts · Ideas</span>
    <div class="utility-right">
      <a href="/donate/">Donate</a>
      <a href={`mailto:${site.submissionsEmail}`}>Submissions</a>
      <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
        <span class="theme-icon theme-icon-light">☼</span><span class="theme-icon theme-icon-dark">☾</span>
      </button>
    </div>
  </div>
  <a class="masthead-logo" href="/" aria-label="The Scandinavian Quarterly home">
    <img src="/assets/images/tsq-wordmark.svg" alt="The Scandinavian Quarterly" />
  </a>
  <div class="masthead-caption"><span>An independent online magazine</span><span>Est. {site.established}</span></div>
  <nav class="primary-nav" aria-label="Main navigation">
    <details class="mobile-nav"><summary>Menu <span aria-hidden="true">+</span></summary><ul class="nav-list">
      <li><a href="/latest/" aria-current={active('/latest/') ? 'page' : undefined}>LATEST</a></li>
      <li><details class="writing-menu languages-menu"><summary>LANGUAGES <span aria-hidden="true">⌄</span></summary><ul>
        <li><a href="/languages/">All languages</a></li>
        {languageGroups.map(group => <li><a href={`/languages/${group.id}/`} aria-current={active(`/languages/${group.id}/`) ? 'page' : undefined}>{group.label}</a></li>)}
      </ul></details></li>
      <li><details class="writing-menu"><summary>WRITING <span aria-hidden="true">⌄</span></summary><ul>
        <li><a href="/writing/poetry/">Poetry</a></li>
        <li><a href="/writing/fiction/">Fiction</a></li>
        <li><a href="/writing/essays-criticism/">Essays &amp; Criticism</a></li>
        <li><a href="/writing/translation/">Translation</a></li>
        <li><a href="/interviews/">Interviews</a></li>
      </ul></details></li>
      <li><a href="/writing/art-photography/">ART</a></li>
      <li><a href="/whats-on/" aria-current={active('/whats-on/') ? 'page' : undefined}>WHAT'S ON</a></li>
      <li><a href="/issues/">ISSUES</a></li>
      <li><a href="/contributors/">CONTRIBUTORS</a></li>
      <li><a href="/submit/">SUBMIT</a></li>
    </ul></details>
    <div class="desktop-nav"><ul class="nav-list">
      <li><a href="/latest/" aria-current={active('/latest/') ? 'page' : undefined}>LATEST</a></li>
      <li><details class="writing-menu languages-menu"><summary>LANGUAGES <span aria-hidden="true">⌄</span></summary><ul>
        <li><a href="/languages/">All languages</a></li>
        {languageGroups.map(group => <li><a href={`/languages/${group.id}/`} aria-current={active(`/languages/${group.id}/`) ? 'page' : undefined}>{group.label}</a></li>)}
      </ul></details></li>
      <li><details class="writing-menu"><summary>WRITING <span aria-hidden="true">⌄</span></summary><ul>
        <li><a href="/writing/poetry/">Poetry</a></li>
        <li><a href="/writing/fiction/">Fiction</a></li>
        <li><a href="/writing/essays-criticism/">Essays &amp; Criticism</a></li>
        <li><a href="/writing/translation/">Translation</a></li>
        <li><a href="/interviews/">Interviews</a></li>
      </ul></details></li>
      <li><a href="/writing/art-photography/">ART</a></li>
      <li><a href="/whats-on/" aria-current={active('/whats-on/') ? 'page' : undefined}>WHAT'S ON</a></li>
      <li><a href="/issues/">ISSUES</a></li>
      <li><a href="/contributors/">CONTRIBUTORS</a></li>
      <li><a href="/submit/">SUBMIT</a></li>
    </ul></div>
  </nav>
</header>
<style>
  @media (min-width: 761px) and (max-width: 1100px) {
    .nav-list { gap: 14px; font-size: 12px; }
  }
</style>
