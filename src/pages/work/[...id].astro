---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { getOriginalLanguage } from '../../data/originalLanguages';
export async function getStaticPaths(){ const work=await getCollection('work',({data})=>!data.draft); return work.map(entry=>({params:{id:entry.id},props:{entry}})); }
const {entry}=Astro.props;
const {Content}=await render(entry);
const d=entry.data;
const originalLanguage = getOriginalLanguage(d.original_language, d.language_detail);
// Pages CMS sometimes saves each verse line as a separate Markdown paragraph.
// Detect those entries so we can tighten lines without affecting stanza-formatted poems.
const poemSource = entry.body ?? '';
const nonEmptyPoemLines = poemSource.split(/\r?\n/).filter(line => line.trim().length > 0).length;
const poemParagraphBreaks = (poemSource.match(/\r?\n[ \t]*\r?\n/g) ?? []).length;
const compactPoetryLines = d.category === 'poetry' &&
  nonEmptyPoemLines > 5 &&
  poemParagraphBreaks >= nonEmptyPoemLines * 0.65;
// Markdown hard line breaks already render as <br>; CSS pre-line would double them.
const poetryHardBreaks = d.category === 'poetry' && / {2,}\r?\n/.test(poemSource);
const contributor=await getEntry('contributors', d.contributor);
const authorName=contributor?.data.name ?? d.contributor.replace(/-/g,' ');
const date=new Intl.DateTimeFormat('en-GB',{day:'numeric',month:'long',year:'numeric'}).format(d.publish_date);
const labels:Record<string,string>={poetry:'Poetry',fiction:'Fiction',essay:'Essay',criticism:'Criticism',translation:'Translation',art:'Art',photography:'Photography',interview:'Interview'};
---
<BaseLayout title={d.title} description={d.excerpt ?? `${d.title} by ${authorName}, published in The Scandinavian Quarterly.`}>
<article class:list={["standard-page", "work-article", { "work-poetry": d.category === "poetry", "compact-poetry-lines": compactPoetryLines, "poetry-hard-breaks": poetryHardBreaks }]}><header class="page-heading wrap"><p class="eyebrow">{labels[d.category] ?? d.category}</p><h1>{d.title}</h1><p class="standfirst">by <a href={`/contributors/${d.contributor}/`}>{authorName}</a></p><div class="article-meta"><span>{date}</span>{originalLanguage && <a href={`/writing/in-the-original/?language=${originalLanguage.group}`}>{originalLanguage.label} · In the Original</a>}{d.issue && <a href={`/issues/${d.issue}/`}>Issue: {d.issue.replace(/-/g,' ')}</a>}</div></header>{d.featured_image && <div class="article-feature"><img src={d.featured_image} alt={d.featured_image_alt ?? ''} /></div>}<div class="gh-content" lang={originalLanguage?.htmlLang || undefined}>{d.previously_published && <p class="reprint-note" lang="en">This work was first published{d.first_publication_title ? <> in <em>{d.first_publication_title}</em></> : null}{d.first_publication_date ? <> ({d.first_publication_date})</> : null}.{d.first_publication_url && <> <a href={d.first_publication_url}>View the original publication ↗</a></>}</p>}<Content />
{originalLanguage && d.english_summary && <aside class="original-summary" lang="en"><h2>About this work</h2><p>{d.english_summary}</p></aside>}
{originalLanguage && d.english_translation && <section class="original-translation" lang="en" aria-label="English translation"><p class="eyebrow">English translation</p>{d.english_title && <h2>{d.english_title}</h2>}<div class="translation-text">{d.english_translation}</div>{d.translator && <p class="translation-credit">Translated by {d.translator}</p>}</section>}
<hr/><p lang="en"><a href={`/contributors/${d.contributor}/`}>More from {authorName} →</a></p></div></article>
</BaseLayout>
