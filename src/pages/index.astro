---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { getCollection } from 'astro:content';
const work = (await getCollection('work', ({data}) => !data.draft)).sort((a,b)=>b.data.publish_date.valueOf()-a.data.publish_date.valueOf());
const latest = work.slice(0,6);
const poem = work.find(x=>x.data.category==='poetry');
const fiction = work.find(x=>x.data.category==='fiction');
const image = work.find(x=>['art','photography'].includes(x.data.category));
---
<BaseLayout title="Home">
  <div class="wrap home">
    <section class="static-hero"><div class="lead-copy"><p class="eyebrow">The Scandinavian Quarterly</p><h1>Literature,<br/>across borders.</h1><p class="standfirst">Fiction, poetry, essays, criticism, translation, art and photography from the Nordic region and beyond.</p><div class="inline-actions"><a class="button" href="/submit/">Submit your work</a><a class="read-link" href="/about/">About the magazine <span aria-hidden="true">↗</span></a></div></div><div class="static-hero-art"><img src="/assets/images/northern-water.svg" alt="Abstract northern shoreline artwork" /></div></section>
    <div class="weekly-grid">
      <section class="weekly-slot"><p class="eyebrow">Poem of the Week</p>{poem ? <><h3><a href={`/work/${poem.id}/`}>{poem.data.title}</a></h3><p>{poem.data.excerpt ?? ''}</p></> : <><h3>A space for poetry.</h3><p>New writing forthcoming.</p></>}</section>
      <section class="weekly-slot"><p class="eyebrow">Story of the Week</p>{fiction ? <><h3><a href={`/work/${fiction.id}/`}>{fiction.data.title}</a></h3><p>{fiction.data.excerpt ?? ''}</p></> : <><h3>A space for fiction.</h3><p>New writing forthcoming.</p></>}</section>
      <section class="weekly-slot"><p class="eyebrow">Image of the Week</p>{image ? <><h3><a href={`/work/${image.id}/`}>{image.data.title}</a></h3><p>{image.data.excerpt ?? ''}</p></> : <><h3>Art &amp; photography.</h3><p>New visual work forthcoming.</p></>}</section>
    </div>
    <section class="current-issue"><div class="issue-cover"><img src="/assets/images/spring-27-cover.png" alt="The Scandinavian Quarterly Spring 2027 cover" /></div><div class="issue-copy"><p class="eyebrow">Online issue</p><h2>Spring 2027</h2><p>Our first seasonal collection of fiction, poetry, essays, criticism, translation, art and photography. Every piece published by TSQ is free to read online.</p><div class="inline-actions"><a class="button" href="/issues/">Explore the issue <span aria-hidden="true">↗</span></a><a class="read-link" href="/submit/">Submit work</a></div></div></section>
    <section class="section"><div class="section-heading"><h2>Latest</h2><a href="/latest/">All new work <span aria-hidden="true">↗</span></a></div>{latest.length ? <div class="story-grid">{latest.map(entry=><WorkCard entry={entry}/>)}</div> : <div class="story-grid"><article class="placeholder-card"><p class="eyebrow">News</p><h3>Spring 2027</h3><p>Our first online issue is in development. New work and contributor announcements will appear here.</p></article><article class="placeholder-card"><p class="eyebrow">Submissions</p><h3>Send us your work</h3><p>TSQ accepts submissions by email across writing, art and photography.</p><a class="read-link" href="/submission-guidelines/">Read the guidelines</a></article><article class="placeholder-card"><p class="eyebrow">The magazine</p><h3>Free to read</h3><p>TSQ does not place published work behind a paywall. Readers who want to support the magazine can donate.</p><a class="read-link" href="/donate/">Support TSQ</a></article></div>}</section>
    <section class="newsletter"><div><p class="eyebrow">Submissions desk</p><h2>Have work for TSQ?</h2><p>Send writing, art or photography directly to the editorial inbox.</p></div><div><a class="email-address" href="mailto:submissions@thescandinavianquarterly.com?subject=TSQ%20Submission">submissions@thescandinavianquarterly.com</a><p class="fine-print">Please put the category in your email subject line.</p></div></section>
  </div>
</BaseLayout>
