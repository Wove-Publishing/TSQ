---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const people = (await getCollection('contributors', ({data}) => !data.draft))
  .sort((a,b) => a.data.name.localeCompare(b.data.name, 'sv'));
---
<BaseLayout title="Contributors">
  <article class="standard-page contributors-directory-page">
    <header class="page-heading wrap">
      <p class="eyebrow">The people in the pages</p>
      <h1>Contributors</h1>
      <p class="standfirst">Writers, translators, artists and photographers published by TSQ.</p>
    </header>
    <div class="gh-content">
      {people.length ? (
        <ul class="contributors-name-list">
          {people.map(person => (
            <li>
              <a href={`/contributors/${person.id}/`}>{person.data.name}</a>
              {person.data.role && <span class="contributor-list-role"> — {person.data.role}</span>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-state">This directory will grow as new work is published.</p>
      )}
    </div>
  </article>
</BaseLayout>
