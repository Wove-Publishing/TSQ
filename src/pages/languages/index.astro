---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { appearsInLanguageGroup, languageGroups } from '../../data/originalLanguages';

const entries = await getCollection('work', ({data})=>!data.draft);
const groups = languageGroups.map(group=>({
  ...group,
  count: entries.filter(entry=>appearsInLanguageGroup(entry.data,group.id)).length
}));
---
<BaseLayout title="Languages" description="Discover literature in the original languages of the Nordic region, as well as English.">
  <article class="standard-page language-index">
    <header class="page-heading wrap">
      <p class="eyebrow">The Scandinavian Quarterly</p>
      <h1>Languages</h1>
      <p class="standfirst">Literature across languages, read as it was written.</p>
    </header>
    <div class="wrap language-intro">
      <p>Browse the original languages of Nordic writing, or explore work available to read in English, including translations. Open any language to find poetry, fiction, essays and criticism.</p>
    </div>
    <div class="wrap language-index-grid">
      {groups.map(group=><a class="language-index-card" href={`/languages/${group.id}/`}>
        <span class="eyebrow">{group.count} {group.count===1?'work':'works'}</span>
        <h2>{group.label}</h2><p>{group.description}</p><span class="language-more">Explore writing ↗</span>
      </a>)}
    </div>
    <div class="wrap language-outro">
      <p>Language metadata is being added to our existing archive. All published work remains available through <a href="/latest/">Latest</a> and <a href="/writing/poetry/">Writing</a>.</p>
      <p>Write in one of these languages? <a href="/submission-guidelines/">Read our submission guidelines.</a></p>
    </div>
  </article>
</BaseLayout>
